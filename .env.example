# Optional public WalletConnect project identifier. Injected wallets work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Static website publishing has no secret/environment configuration.
# It is pinned to Irys devnet + Avalanche Fuji (43113), using injected wallets.
# No mainnet or arbitrary gateway override is accepted by the publisher.
# See docs/publishing.md for build, consent, recovery and manual acceptance steps.
